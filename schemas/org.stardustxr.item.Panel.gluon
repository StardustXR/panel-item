import "org.stardustxr.Types" as types
import "org.stardustxr.Keymap" as keymap
import "org.stardustxr.Dmatex" as dmatex

/// PanelItem
interface PanelItem {
	pointer_motion(surface: SurfaceId, delta: Option<types::Vec2f>, position: types::Vec2f, timestamp: Option<types::Timestamp>)
	// uses event ids from `input_event_codes.h`
	pointer_button(surface: SurfaceId, button: u32, pressed: bool, timestamp: Option<types::Timestamp>)
	// TODO: expose stop timestamp?
	pointer_scroll_pixels(surface: SurfaceId, delta: types::Vec2f, source: ScrollSource, timestamp: Option<types::Timestamp>)
	pointer_scroll_discrete(surface: SurfaceId, delta: types::Vec2f, source: ScrollSource, timestamp: Option<types::Timestamp>)
	// TODO: expose stop timestamp?
	pointer_scroll_stop(surface: SurfaceId, timestamp: Option<types::Timestamp>)
	key(surface: SurfaceId, key: u32, pressed: bool, modifier_state: ModifierState, keymap: Ref<keymap::Keymap>, timestamp: Option<types::Timestamp>)
	touch_down(surface: SurfaceId, touch_id: u32, position: types::Vec2f, timestamp: Option<types::Timestamp>)
	touch_move(touch_id: u32, position: types::Vec2f, timestamp: Option<types::Timestamp>)
	touch_up(touch_id: u32, timestamp: Option<types::Timestamp>)

	close_toplevel()

	resize_toplevel_to_app_request()
	request_toplevel_resize(new_size: types::Size2)
	// if the toplevel should be treated as "focused", this defaults to true on panelItem connect
	toplevel_focused(focused: bool)
	
}

/// PanelShell
interface PanelShell {
	update_surface_dmatex(surface: SurfaceUpdateTarget, dmatex: Ref<dmatex::DmatexRef>, acquire_point: u64, release_point: Ref<dmatex::DmatexSubmitRelease>, opaque: bool)

	toplevel_resized(new_size: types::Size2)
	toplevel_max_size(max_size: Option<types::Size2>)
	toplevel_min_size(min_size: Option<types::Size2>)
	toplevel_fullscreen(fullscreen_active: bool)
	toplevel_title(title: String)
	toplevel_app_id(app_id: String)

	set_cursor_visuals(geometry: Option<Geometry>)
	create_child(child: ChildState)
	move_child(child_id: u64, geometry: Geometry)
	destroy_child(child_id: u64)
}

/// Modifier state driven by xkbcommon
struct ModifierState {
	depressed: u32,
	latched: u32,
	locked: u32,
	layout_group: u32,
}

/// ScrollSource
enum ScrollSource {
	Wheel,
	Touch,
	Continuous,
	WheelTilt,
}

/// SurfaceId
enum SurfaceId {
	Toplevel,
	Child { id: u64 },
}

/// SurfaceDmatexTarget
enum SurfaceUpdateTarget {
	Toplevel,
	Child { id: u64 },
	Cursor,
}

/// ToplevelState
struct ToplevelState {
	parent: Option<u64>,
	title: Option<String>,
	app_id: Option<String>,
	size: types::Size2,
	min_size: Option<types::Size2>,
	max_size: Option<types::Size2>,
}

/// ChildState
struct ChildState {
	id: u64,
	parent: SurfaceId,
	geometry: Geometry,
	z_order: i32,
	input_regions: Vec<Rect>,
}

/// PanelItemInitData
struct PanelItemInitData {
	cursor: Option<Geometry>,
	toplevel: ToplevelState,
	children: Vec<ChildState>,
}

/// Rect
struct Rect {
	origin: types::Vec2f,
	size: types::Vec2f,
}

/// Geometry
struct Geometry {
	origin: types::Vec2i,
	size: types::Size2,
}
